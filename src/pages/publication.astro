---
import { publication } from "@/data/publication";
import PageLayout from "@/layouts/Base.astro";
import { absoluteUrl } from "@/utils/path";
import { Schema } from "astro-seo-schema";

const siteUrl = (path: string) => absoluteUrl(path, Astro.site);
---

<PageLayout meta={{ title: "Publication" }}>
	<Schema
		slot="head"
		item={{
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			itemListElement: [
				{
					"@type": "ListItem",
					position: 1,
					name: "Home",
					item: siteUrl("/"),
				},
				{
					"@type": "ListItem",
					position: 2,
					name: "Publication",
					item: siteUrl("/publication"),
				},
			],
		}}
	/>
	<section class="work" aria-labelledby="work-label">
		<div class="section-label" id="work-label">Publication</div>
		<p class="intro">
			List of publication.
		</p>
		<ul class="work-list">
			{
				publication.map((item) => (
					<li>
						<a href={item.href} rel="noreferrer" target="_blank">
							<div class="head">
								<span class="name">{item.name}</span>
							</div>
							<p>{item.desc}</p>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</PageLayout>

<style>
	.work {
		margin-bottom: 88px;
	}
	.intro {
		font-family: var(--font-serif);
		font-size: 17.5px;
		line-height: 1.7;
		color: hsl(var(--theme-text));
		margin: 0 0 36px;
		max-width: 60ch;
		text-wrap: pretty;
	}

	@media (max-width: 720px) {
		.intro {
			font-size: 17px;
			margin-bottom: 28px;
		}
	}
	@media (max-width: 420px) {
		.work {
			margin-bottom: 56px;
		}
		.intro {
			font-size: 16.5px;
		}
	}
</style>
